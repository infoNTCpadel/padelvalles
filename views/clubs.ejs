<div class="banda-pagina">
  <div class="contenidor">
    <h1>Clubs del Vallès</h1>
    <p>El directori de clubs de pàdel del Vallès Occidental i Oriental.</p>
  </div>
</div>

<form class="filtres" action="/clubs" method="get" role="search" style="grid-template-columns: 2fr 1fr auto">
  <div class="camp"><label>Cerca</label><input type="search" name="q" placeholder="Cerca per nom o municipi..." value="<%= q %>"></div>
  <div class="camp"><label>Comarca</label>
    <select name="comarca">
      <option value="">Totes</option>
      <% for (const [k, v] of Object.entries(COMARQUES)) { %>
        <option value="<%= k %>" <%= comarca === k ? 'selected' : '' %>><%= v %></option>
      <% } %>
    </select>
  </div>
  <div class="camp"><label>&nbsp;</label><button class="boto" type="submit">Cerca</button></div>
</form>

<div class="graella">
  <% for (const c of clubs) { %>
    <article class="targeta targeta-club">
      <div class="cos">
        <div class="club-icona" aria-hidden="true"><%= c.name.trim().charAt(0).toUpperCase() %></div>
        <div>
          <h3><a href="/club/<%= c.id %>"><%= c.name %></a><%- c.claimed ? ' <span class="verificat" title="Club verificat: gestionat pel propi club">✅</span>' : '' %></h3>
          <div class="meta">📍 <%= c.town %> · <%= COMARQUES[c.comarca] %></div>
          <% if (c.courts) { %><div class="meta"><%= c.courts %> pistes</div><% } %>
        </div>
      </div>
    </article>
  <% } %>
</div>
<% if (!clubs.length) { %><p>Encara no hi ha clubs en aquesta comarca.</p><% } %>
