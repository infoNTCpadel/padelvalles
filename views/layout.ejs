<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titol %> · <%= brand.name %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : brand.tagline %>">
<% if (typeof canonical !== 'undefined' && canonical) { %>
<link rel="canonical" href="<%= canonical %>">
<meta property="og:url" content="<%= canonical %>">
<% } %>
<meta property="og:site_name" content="<%= brand.name %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= titol %> · <%= brand.name %>">
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %><meta property="og:description" content="<%= metaDescription %>"><% } %>
<% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
<link rel="icon" type="image/png" href="/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="cap">
  <div class="contenidor cap-flex">
    <a class="marca" href="/"><img src="/logo.png" alt="PadelVallès"><span class="marca-logo">PadelVallès</span></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
    <label for="nav-toggle" class="nav-boto" aria-label="Obre el menú">☰</label>
    <nav class="nav">
      <a href="/">Inici</a>
      <a href="/tornejos">Tornejos</a>
      <a href="/clubs">Clubs</a>
      <% if (user) { %>
        <% if (typeof tePanell !== 'undefined' && tePanell) { %><a href="/club/panel">Panell del club</a><% } %>
        <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <a class="qui-ses" href="/elmeucompte" title="El meu compte">👤 <span class="qui-nom"><%= user.name %></span><% if (typeof invitacionsPendents !== 'undefined' && invitacionsPendents > 0) { %> <span class="insignia comptador"><%= invitacionsPendents %></span><% } %></a>
        <form class="enlinia" action="/surt" method="post"><button class="boto menut" type="submit">Surt</button></form>
      <% } else { %>
        <a href="/entra">Entra</a>
        <a class="boto menut" href="/registre">Registre't</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="contenidor">
  <%- body %>
</main>
<footer class="peu">
  <div class="contenidor peu-flex">
    <span><strong>PadelVallès</strong> · <%= brand.tagline %></span>
    <span><a href="/avis-legal">Avís legal</a> · <a href="/privacitat">Privacitat</a> · <a href="/cookies">Cookies</a></span>
  </div>
</footer>
</body>
</html>
