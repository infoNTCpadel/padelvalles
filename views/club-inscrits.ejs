<h1>Inscrits: <%= t.name %></h1>
<% const base = typeof baseRuta !== 'undefined' && baseRuta ? baseRuta : '/club'; %>
<% const nomPanell = base === '/organitzador' ? "Panell de l'organitzador" : 'Panell del club'; %>
<p><a href="<%= base %>/panel">← <%= nomPanell %></a> · <a href="<%= base %>/torneig/<%= t.id %>/inscrits.csv">⬇ Descarrega CSV</a></p>
<% if (t.registration_deadline) { %><p class="meta">Inscripcions obertes fins al <%= t.registration_deadline %>.</p><% } %>
<p class="meta">Els jugadors es poden donar de baixa ells mateixos fins a <%= t.unregister_hours ?? 48 %> hores abans de l'inici. El pagament es fa fora de la plataforma: marca aquí qui ha pagat.</p>

<% if ((t.registration_mode || 'externa') === 'padelvalles') { %>
<h2>Afegeix una parella</h2>
<% if (alta) { %><div class="exit">Parella afegida correctament.</div><% } %>
<% if (errorMsg) { %><div class="error"><%= errorMsg %></div><% } %>
<form class="formulari" action="<%= base %>/torneig/<%= t.id %>/inscrits/nova" method="post">
  <div class="fila">
    <div class="camp"><label>Categoria</label>
      <select name="categoria" required>
        <% for (const c of categories) { %><option value="<%= c.id %>"><%= c.etiqueta %></option><% } %>
      </select>
    </div>
    <div class="camp"><label>&nbsp;</label><label><input type="checkbox" name="pagat" value="1"> Pagat</label></div>
  </div>
  <div class="fila">
    <div class="camp"><label>Jugador 1 · nom</label><input name="nom1" required maxlength="80" placeholder="Nom i cognoms"></div>
    <div class="camp cerca-usuari"><label>Jugador 1 · té compte? cerca'l pel nom</label>
      <input type="text" class="cerca-usuari-nom" maxlength="120" placeholder="opcional" autocomplete="off">
      <input type="hidden" name="email1">
      <div class="suggeriments"></div>
    </div>
  </div>
  <div class="fila">
    <div class="camp"><label>Jugador 2 · nom</label><input name="nom2" required maxlength="80" placeholder="Nom i cognoms"></div>
    <div class="camp cerca-usuari"><label>Jugador 2 · té compte? cerca'l pel nom</label>
      <input type="text" class="cerca-usuari-nom" maxlength="120" placeholder="opcional" autocomplete="off">
      <input type="hidden" name="email2">
      <div class="suggeriments"></div>
    </div>
  </div>
  <p class="ajuda">Per a les parelles que s'apunten per telèfon, WhatsApp o a recepció. Cerca el jugador pel nom i tria'l de la llista: la parella quedarà vinculada al seu compte i rebrà l'avís per email. Si no té compte, deixa-ho en blanc i queda apuntada només amb el nom.</p>
  <button class="boto" type="submit">Afegeix la parella</button>
</form>
<%- include('cerca-usuari-script') %>
<% } %>

<% const __pendentsComp = (typeof competicionsPerCat !== 'undefined' ? categories.filter(c => !competicionsPerCat[c.id]) : []); %>
<% const __potCrearComp = (typeof esGestor !== 'undefined' ? esGestor : true) && (t.registration_mode || 'externa') === 'padelvalles'; %>
<% if (typeof creades !== 'undefined' && creades) { %><div class="exit">S'han creat <%= creades %> competicions amb les parelles importades.</div><% } %>
<% if (__potCrearComp && (t.servei || 'dashboard') === 'torneig' && __pendentsComp.length) { %>
  <p><a class="boto" href="<%= base %>/torneig/<%= t.id %>/competicions/nova">🏆 Crea les competicions (<%= __pendentsComp.length %>)</a>
  <span class="meta">Una per categoria, amb les parelles ja importades.</span></p>
<% } else if (__potCrearComp && (t.servei || 'dashboard') === 'inscripcions') { %>
  <p class="ajuda">💡 Vols gestionar també els quadres, els resultats i les classificacions? <a href="/serveis">Descobreix el servei Torneig</a>.</p>
<% } %>

<% for (const c of categories) { %>
  <h2><%= c.etiqueta %><% if (c.max_pairs) { %> <small class="meta">(<%= c.nInscrits %>/<%= c.max_pairs %> places)</small><% } else { %> <small class="meta">(<%= c.nInscrits %> inscrits)</small><% } %></h2>

  <% const comp = (typeof competicionsPerCat !== 'undefined' && competicionsPerCat[c.id]) || null; %>
  <% if (comp) { %>
    <p>🏆 <a href="<%= base %>/torneig/<%= t.id %>/competicio/<%= comp.id %>"><strong><%= comp.name %></strong></a>
    <span class="meta">· <%= FORMATS[comp.format].nom %> · <%= comp.n_actius %> participants · <%= ESTATS_COMPETICIO[comp.status] %></span></p>
  <% } %>

  <% if (!c.registered.length && !c.waitlist.length && !c.pending.length) { %>
    <p class="meta">Encara no hi ha inscripcions en aquesta categoria.</p>
  <% } %>

  <% if (c.registered.length) { %>
  <table class="llista">
    <tr><th>Parella</th><th>Contacte</th><th>Pagat</th><th></th></tr>
    <% for (const i of c.registered) { %>
      <tr>
        <td><%= i.nom1 %> / <%= i.nom2 %></td>
        <td class="meta"><%= i.email1 %><% if (i.tel1) { %> · 📞 <%= i.tel1 %><% } %><br><%= i.email2 %><% if (i.tel2) { %> · 📞 <%= i.tel2 %><% } %></td>
        <td>
          <form class="enlinia" action="<%= base %>/torneig/<%= t.id %>/inscrits/<%= i.id %>/pagat" method="post">
            <button class="boto <%= i.paid ? '' : 'secundari' %> menut"><%= i.paid ? '✓ Pagat' : 'Marca pagat' %></button>
          </form>
        </td>
        <td>
          <form class="enlinia" action="<%= base %>/torneig/<%= t.id %>/inscrits/<%= i.id %>/treu" method="post"
            onsubmit="return confirm('Vols donar de baixa aquesta parella? Si hi ha llista d\u2019espera, la primera parella pujarà automàticament.')">
            <button class="boto secundari menut">Treu</button>
          </form>
        </td>
      </tr>
    <% } %>
  </table>
  <% } %>

  <% if (c.waitlist.length) { %>
    <h3>Llista d'espera</h3>
    <table class="llista">
      <tr><th>#</th><th>Parella</th><th></th></tr>
      <% c.waitlist.forEach((i, idx) => { %>
        <tr>
          <td><%= idx + 1 %></td>
          <td><%= i.nom1 %> / <%= i.nom2 %></td>
          <td>
            <form class="enlinia" action="<%= base %>/torneig/<%= t.id %>/inscrits/<%= i.id %>/treu" method="post">
              <button class="boto secundari menut">Treu</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </table>
  <% } %>

  <% if (c.pending.length) { %>
    <h3>Invitacions pendents</h3>
    <ul>
      <% for (const i of c.pending) { %>
        <li><%= i.nom1 %> ha convidat <%= i.nom2 %> <span class="meta">(esperant resposta)</span>
          <form class="enlinia" action="<%= base %>/torneig/<%= t.id %>/inscrits/<%= i.id %>/treu" method="post">
            <button class="boto secundari menut">Cancel·la</button>
          </form>
        </li>
      <% } %>
    </ul>
  <% } %>
<% } %>
