<% const MESOS = ['GEN','FEB','MAR','ABR','MAI','JUN','JUL','AGO','SET','OCT','NOV','DES']; %>
<% const _d = String(t.starts_at || '').slice(8, 10); const _m = MESOS[Number(String(t.starts_at || '').slice(5, 7)) - 1] || ''; %>
<p><a class="torna" href="/tornejos">← Torna als tornejos</a></p>
<% if (typeof avis !== 'undefined' && avis === 'enviat') { %><div class="exit">Gràcies, hem rebut el teu avís i el revisarem.</div><% } %>
<% if (typeof missatge !== 'undefined' && missatge) { %><div class="exit"><%= missatge %></div><% } %>
<% if (typeof errorMsg !== 'undefined' && errorMsg) { %><div class="error"><%= errorMsg %></div><% } %>

<div class="banda-torneig">
  <div class="contenidor">
    <% if (_d) { %><div class="data-gran" aria-hidden="true"><span class="dia"><%= _d %></span><span class="mes"><%= _m %></span></div><% } %>
    <div>
      <h1><%= t.name %></h1>
      <div class="meta">📍 <a href="/club/<%= t.club_id %>"><%= t.club_nom %></a><%- t.club_claimed ? ' <span class="verificat" title="Club verificat: gestionat pel propi club">✅</span>' : '' %> · <%= t.club_poble %></div>
      <div class="etiquetes">
        <span class="etiqueta-clara"><%= TIPUS_TORNEIG[t.tipus] || TIPUS_TORNEIG.open %></span>
        <% if (typeof estat !== 'undefined') { %><span class="etiqueta-clara"><%= estat.etiqueta %></span><% } %>
        <% for (const c of t.categories) { %><span class="etiqueta-clara"><%= MODALITATS[c.modality] %><%= c.level ? ' · ' + c.level : '' %></span><% } %>
      </div>
    </div>
  </div>
</div>

<div class="fitxa-nova">
  <div>
    <% if (typeof estat !== 'undefined' && estat.clau !== 'oberta') { %>
      <div class="avis"><%= estat.clau === 'finalitzat' ? 'Aquest torneig ja ha finalitzat.' : estat.clau === 'enjoc' ? 'Aquest torneig ja està en joc.' : 'Les inscripcions d’aquest torneig estan tancades.' %></div>
    <% } %>

    <div class="info-reixeta">
      <div class="info-casella"><div class="k">Dates</div><div class="v">📅 <%= t.starts_at %> – <%= t.ends_at %></div></div>
      <div class="info-casella"><div class="k">Club</div><div class="v">📍 <a href="/club/<%= t.club_id %>"><%= t.club_nom %></a><%- t.club_claimed ? ' <span class="verificat" title="Club verificat: gestionat pel propi club">✅</span>' : '' %></div></div>
      <% if (user && t.price_text) { %><div class="info-casella"><div class="k">Preu</div><div class="v">🎟️ <%= t.price_text %></div></div><% } %>
      <% if (t.categories.length) { %><div class="info-casella"><div class="k">Categories</div><div class="v"><%= t.categories.length %></div></div><% } %>
    </div>

    <% if (user && t.description) { %>
      <div class="info-casella" style="margin-bottom:1.4rem"><div class="k">Informació</div><div class="v" style="font-weight:normal"><%= t.description %></div></div>
    <% } %>

    <% if (user) { %>
      <h2>Com m'hi inscriva?</h2>
      <% if (modePV) { %>
        <%- include('torneig-inscripcio') %>
      <% } else { %>
        <% if (t.registration_url) { %>
          <p><a class="boto" href="<%= t.registration_url %>" target="_blank" rel="nofollow noopener">Inscriu-t'hi al web del club</a></p>
        <% } %>
        <% if (t.registration_info) { %><p><%= t.registration_info %></p><% } %>
        <% if (!t.registration_url && !t.registration_info) { %><p>Contacta amb el club per inscriure-t'hi.</p><% } %>
      <% } %>
    <% } %>

    <% if (typeof inscritsPerCat !== 'undefined' && t.categories.length) { %>
      <h2>Inscrits</h2>
      <ul class="llista-neta">
      <% for (const c of t.categories) { const info = inscritsPerCat[c.id] || { n: 0, max: null, parelles: [] }; %>
        <li><strong><%= MODALITATS[c.modality] %><%= c.level ? ' · ' + c.level : '' %></strong>:
          <%= info.n %><%= info.max ? '/' + info.max : '' %> parelles
          <% if (user && info.parelles.length) { %><br><span class="meta"><%= info.parelles.map(p => p.player1_name + ' / ' + p.player2_name).join(' · ') %></span><% } %>
        </li>
      <% } %>
      </ul>
    <% } %>

    <details style="margin-top:1.5rem">
      <summary>Veus alguna cosa estranya en aquest torneig? Avisa'ns</summary>
      <form action="/torneig/<%= t.id %>/avis" method="post" class="formulari">
        <div class="camp">
          <label>Què hi veus de malament?</label>
          <textarea name="missatge" rows="3" maxlength="500" required placeholder="P. ex.: sembla una promoció, les dates són errònies..."></textarea>
        </div>
        <button class="boto secundari menut" type="submit">Envia l'avís</button>
      </form>
    </details>
  </div>

  <aside class="fitxa-lateral">
    <% if (user) { %>
      <div class="targeta-lateral">
        <h3>Cartells</h3>
        <% if (t.poster_path) { %>
          <div class="k" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.8px;color:#6B6257;font-weight:700;margin-bottom:.25rem">Cartell del club</div>
          <img class="cartell" src="<%= logoUrl(t.poster_path) %>" alt="Cartell original: <%= t.name %>" style="margin-bottom:.8rem">
        <% } %>
        <div class="k" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.8px;color:#6B6257;font-weight:700;margin-bottom:.25rem">Cartell PadelVallès</div>
        <img class="cartell" src="/torneig/<%= t.id %>/cartell.svg" alt="Cartell oficial: <%= t.name %>">
      </div>
      <div class="targeta-lateral">
        <h3>Segueix el torneig</h3>
        <% if (interessat) { %>
          <form class="enlinia" action="/torneig/<%= t.id %>/no-interessa" method="post"><button class="boto secundari menut">★ Ja no m'interessa</button></form>
        <% } else { %>
          <form class="enlinia" action="/torneig/<%= t.id %>/interessa" method="post"><button class="boto menut">☆ M'interessa</button></form>
        <% } %>
        <p style="margin:.8rem 0 0"><a class="boto secundari menut" href="https://wa.me/?text=<%= encodeURIComponent(shareText + ' ' + shareUrl) %>" target="_blank" rel="noopener">↗ Comparteix per WhatsApp</a></p>
      </div>
    <% } else { %>
      <div class="targeta-lateral registre-cta" style="border:2px solid var(--accent); text-align:center">
        <h3>Vols veure'n tots els detalls?</h3>
        <p>El cartell oficial, el preu, la informació completa i l'enllaç d'inscripció són només per a usuaris registrats.</p>
        <p><a class="boto" href="/registre?next=/torneig/<%= t.id %>">Registra't gratis</a></p>
        <p><a href="/entra?next=/torneig/<%= t.id %>">Ja tinc compte</a></p>
      </div>
      <div class="targeta-lateral">
        <h3>Comparteix</h3>
        <p><a class="boto secundari menut" href="https://wa.me/?text=<%= encodeURIComponent(shareText + ' ' + shareUrl) %>" target="_blank" rel="noopener">↗ Comparteix per WhatsApp</a></p>
      </div>
    <% } %>
  </aside>
</div>
