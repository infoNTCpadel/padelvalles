<h1>Clubs</h1>
<p><a href="/admin">← Administració</a> · <a class="boto menut" href="/admin/clubs/nou">＋ Nou club</a></p>

<% if (creat) { const c = clubs.find(x => String(x.id) === String(creat)); %>
  <% if (c) { %><div class="exit">Club «<%= c.name %>» creat i verificat.</div><% } %>
<% } %>

<div class="crm-resum">
  <div class="crm-dada"><strong><%= total %></strong><span>clubs totals</span></div>
  <div class="crm-dada alerta"><strong><%= nPendents %></strong><span>pendents de verificació</span></div>
  <div class="crm-dada alerta"><strong><%= claims.length %></strong><span>sol·licituds de gestió</span></div>
</div>

<% if (claims.length) { %>
  <h2>Sol·licituds de gestió pendents</h2>
  <p class="meta">Aquests usuaris volen gestionar un club. Fins que no ho aprovis, no hi tenen accés.</p>
  <table class="llista">
    <tr><th>Usuari</th><th>Club</th><th>Contacte indicat</th><th>Data</th><th></th></tr>
    <% for (const s of claims) { %>
      <tr>
        <td><strong><%= s.usuari_nom %></strong><br><span class="meta"><%= s.usuari_email %></span></td>
        <td><%= s.club_nom %>
          <% if (!s.club_verificat) { %><br><span class="etiqueta pendent">Club pendent de verificació</span><% } %>
        </td>
        <td><span class="meta"><%= s.note || '—' %></span></td>
        <td><span class="meta"><%= (s.created_at || '').slice(0, 10) %></span></td>
        <td class="accions">
          <form action="/admin/clubs/claims/<%= s.id %>/aprova" method="post" style="display:inline">
            <button class="boto petit" type="submit">Aprova</button>
          </form>
          <form action="/admin/clubs/claims/<%= s.id %>/rebutja" method="post" style="display:inline">
            <button class="boto petit secundari" type="submit" onclick="return confirm('Rebutjar aquesta sol·licitud?')">Rebutja</button>
          </form>
        </td>
      </tr>
    <% } %>
  </table>
<% } %>

<% if (reclamat) { const c = clubs.find(x => String(x.id) === String(reclamat)); %>
  <% if (c && c.claim_token) { %>
    <div class="avis">
      <strong>Enllaç de reclamació per a «<%= c.name %>»:</strong><br>
      <input id="claimLink" readonly value="<%= appUrl %>/reclama/<%= c.claim_token %>" style="width:100%;margin:.5rem 0" onclick="this.select()">
      <button class="boto petit" onclick="navigator.clipboard.writeText(document.getElementById('claimLink').value);this.textContent='Copiat!'">Copia l'enllaç</button>
      <p class="meta">Envia'l al contacte del club (WhatsApp, email...). Qui obri l'enllaç amb un compte verificat quedarà com a gestor del club.</p>
    </div>
  <% } %>
<% } %>

<div class="crm-filtres">
  <div class="crm-pestanyes">
    <a href="/admin/clubs?estat=tots<%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="<%= estat === 'tots' ? 'actiu' : '' %>">Tots (<%= total %>)</a>
    <a href="/admin/clubs?estat=pendents<%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="<%= estat === 'pendents' ? 'actiu' : '' %>">Pendents (<%= nPendents %>)</a>
    <a href="/admin/clubs?estat=verificats<%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="<%= estat === 'verificats' ? 'actiu' : '' %>">Verificats (<%= total - nPendents %>)</a>
  </div>
  <form class="crm-cerca" action="/admin/clubs" method="get">
    <input type="hidden" name="estat" value="<%= estat %>">
    <input type="search" name="q" placeholder="Cerca per nom, municipi o email..." value="<%= q %>">
    <button class="boto petit" type="submit">Cerca</button>
  </form>
</div>

<table class="llista">
  <tr><th>Club</th><th>Contacte</th><th>Gestor</th><th>Tornejos</th><th>Serveis</th><th>Estat</th><th>Accions</th></tr>
  <% for (const c of clubs) { %>
    <tr>
      <td><strong><%= c.name %></strong><br><span class="meta"><%= c.town %> · <%= c.comarca %></span></td>
      <td><span class="meta"><%= c.email || '—' %><br><%= c.phone || '' %></span></td>
      <td>
        <% if (c.gestors) { %>
          <% for (const g of c.gestors.split(';;')) { const [gid, ...rest] = g.split('|'); const geti = rest.join('|'); %>
            <span class="meta"><%= geti %></span>
            <form action="/admin/clubs/<%= c.id %>/gestor/<%= gid %>/treu?estat=<%= estat %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" method="post" style="display:inline">
              <button class="boto petit secundari" type="submit" title="Treure aquest gestor" onclick="return confirm('Treure aquest gestor del club?')">✕</button>
            </form><br>
          <% } %>
        <% } else { %><span class="meta">—</span><% } %>
      </td>
      <td style="text-align:center"><%= c.n_tornejos %></td>
      <td><span class="meta"><% const __rs = (typeof resumsServeis !== 'undefined' && resumsServeis[c.id]) || null; %><% if (__rs) { %>📝 <%= __rs.inscripcions.detall %><br>🏆 <%= __rs.torneig.detall %><% } else { %>—<% } %><br><a href="/admin/clubs/<%= c.id %>/serveis">Gestiona</a></span></td>
      <td><%- c.verified ? '<span class="etiqueta ok">Verificat</span>' : '<span class="etiqueta pendent">Pendent</span>' %></td>
      <td class="accions">
        <a href="/club/<%= c.id %>" target="_blank">Veure</a>
        <a href="/club/perfil/<%= c.id %>">Fitxa</a>
        <form action="/admin/clubs/<%= c.id %>/enllac" method="post" style="display:inline">
          <button class="boto petit secundari" type="submit" title="Genera un enllaç perquè el club reclami la gestió">Enllaç reclamació</button>
        </form>
        <% if (!c.verified) { %>
          <form action="/admin/clubs/<%= c.id %>/aprova" method="post" style="display:inline">
            <button class="boto petit" type="submit">Aprova</button>
          </form>
        <% } else { %>
          <form action="/admin/clubs/<%= c.id %>/amaga?estat=<%= estat %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" method="post" style="display:inline">
            <button class="boto petit secundari" type="submit" title="Amagar el club del web públic (reversible amb Aprova)" onclick="return confirm('Amagar aquest club del web públic? Els seus tornejos també s\u2019ocultaran. Es pot revertir amb Aprova.')">Amaga</button>
          </form>
        <% } %>
      </td>
    </tr>
  <% } %>
</table>
<% if (!clubs.length) { %><p>No hi ha clubs amb aquests filtres.</p><% } %>
