<h1>Usuaris</h1>
<p><a href="/admin">← Administració</a></p>
<p>
  <a href="/admin/usuaris" class="<%= filtre === 'tots' ? 'actiu' : '' %>">Tots</a> ·
  <a href="/admin/usuaris?f=no-verificats" class="<%= filtre === 'no-verificats' ? 'actiu' : '' %>">No verificats (<%= totalNoVerificats %>)</a>
</p>
<% if (filtre === 'no-verificats') { %>
  <p class="meta">Comptes que no han verificat l'email. S'esborren sols passats 30 dies. Pots esborrar-los manualment si són emails erronis o spam.</p>
<% } %>
<% if (esborrat) { %><div class="avis">Compte esborrat.</div><% } %>
<table class="llista">
  <tr><th>Nom</th><th>Email</th><th>Rol</th><th>Verificat</th><th>Alta</th><th></th></tr>
  <% for (const u of usuaris) { %>
    <tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td>
    <td><%= u.email_verified ? 'Sí' : 'No' %></td><td><%= u.created_at.slice(0,10) %></td>
    <td>
      <% if (filtre === 'no-verificats') { %>
        <form class="enlinia" action="/admin/usuaris/<%= u.id %>/elimina" method="post" onsubmit="return confirm('Esborrar aquest compte no verificat?')"><button class="boto secundari menut">Esborra</button></form>
      <% } else if (u.role === 'player') { %>
        <form class="enlinia" action="/admin/usuaris/<%= u.id %>/rol" method="post"><input type="hidden" name="rol" value="monitor"><button class="boto secundari menut">Fes monitor</button></form>
      <% } else if (u.role === 'monitor') { %>
        <form class="enlinia" action="/admin/usuaris/<%= u.id %>/rol" method="post"><input type="hidden" name="rol" value="player"><button class="boto secundari menut">Torna a jugador</button></form>
      <% } %>
    </td></tr>
  <% } %>
</table>
