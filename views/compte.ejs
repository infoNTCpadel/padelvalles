<h1>El meu compte</h1>
<% if (!user.email_verified) { %>
  <div class="error">Encara no has verificat el teu email. Revisa la safata d'entrada (t'hem enviat l'enllaç en registrar-te).
    <form class="enlinia" action="/reenvia-verificacio" method="post"><button class="boto menut secundari" type="submit">Reenvia l'enllaç</button></form>
  </div>
<% } %>
<% if (avisa === 'verifica') { %><div class="error">Verifica el teu email abans de gestionar un club.</div><% } %>

<form class="formulari" action="/elmeucompte" method="post">
  <h2>Les meves dades</h2>
  <div class="camp"><label>Nom i cognoms</label><input name="nom" value="<%= user.name %>" maxlength="80"></div>
  <div class="camp"><label>Email</label><input value="<%= user.email %>" disabled></div>
  <div class="camp"><label>Mòbil</label><input name="telefon" type="tel" maxlength="20" value="<%= user.phone || '' %>" placeholder="600 123 456">
    <p class="meta">Només el veurà el club organitzador dels tornejos on t'inscriguis.</p></div>
  <div class="camp"><label>El teu nivell</label>
    <select name="nivell"><option value="">-- Tria --</option><% for (const n of NIVELLS) { %><option value="<%= n.id %>" <%= user.level === n.id ? 'selected' : '' %> title="<%= n.descripcio %>"><%= n.nom %> (<%= n.rang %>)</option><% } %></select>
  </div>
  <button class="boto" type="submit">Desa els canvis</button>
</form>

<form class="formulari" action="/elmeucompte/contrasenya" method="post">
  <h2>Canvia la contrasenya</h2>
  <% if (q.guardat) { %><div class="flash ok">Dades guardades.</div><% } %>
  <% if (q.contrasenya === 'ok') { %><div class="flash ok">Contrasenya canviada correctament.</div><% } %>
  <% if (q.error === 'contrasenya') { %><div class="flash err">La contrasenya actual no és correcta o la nova té menys de 6 caràcters.</div><% } %>
  <div class="camp"><label>Contrasenya actual</label><input type="password" name="actual" required></div>
  <div class="camp"><label>Nova contrasenya (mínim 6 caràcters)</label><input type="password" name="nova" minlength="6" required></div>
  <button class="boto" type="submit">Canvia la contrasenya</button>
</form>

<% if (elsMeusClubs.length) { %>
  <h2>Els meus clubs</h2>
  <ul><% for (const c of elsMeusClubs) { %><li><a href="/club/<%= c.id %>"><%= c.name %></a></li><% } %></ul>
  <p><a class="boto secundari" href="/club/panel">Anar al panell del club</a></p>
<% } else { %>
  <p><a href="/club/sollicita">Tens un club? Sol·licita el teu compte de club</a></p>
<% } %>

<h2 class="seccio">Les meves inscripcions</h2>
<% if (invitacionsRebudes.length) { %>
  <h3>Invitacions pendents</h3>
  <ul>
  <% for (const i of invitacionsRebudes) { %>
    <li><strong><%= i.qui_nom %></strong> et convida a fer parella a
      <a href="/torneig/<%= i.tournament_id %>"><%= i.torneig_nom %></a>
      (<%= MODALITATS[i.modality] %><%= i.level ? ' · ' + i.level : '' %>)
      <form class="enlinia" action="/torneig/<%= i.tournament_id %>/invitacio/<%= i.id %>/accepta" method="post"><button class="boto menut">Accepta</button></form>
      <form class="enlinia" action="/torneig/<%= i.tournament_id %>/invitacio/<%= i.id %>/rebutja" method="post"><button class="boto secundari menut">Rebutja</button></form>
    </li>
  <% } %>
  </ul>
<% } %>
<% if (invitacionsEnviades.length) { %>
  <h3>Invitacions que has enviat</h3>
  <ul>
  <% for (const i of invitacionsEnviades) { %>
    <li><a href="/torneig/<%= i.tournament_id %>"><%= i.torneig_nom %></a>
      (<%= MODALITATS[i.modality] %><%= i.level ? ' · ' + i.level : '' %>): esperant <%= i.qui_nom %>
      <form class="enlinia" action="/torneig/<%= i.tournament_id %>/invitacio/<%= i.id %>/cancella" method="post"><button class="boto secundari menut">Cancel·la</button></form>
    </li>
  <% } %>
  </ul>
<% } %>
<% if (inscripcions.length) { %>
  <table class="llista">
    <tr><th>Torneig</th><th>Categoria</th><th>Parella</th><th>Estat</th><th></th></tr>
    <% for (const i of inscripcions) { %>
      <tr>
        <td><a href="/torneig/<%= i.tournament_id %>"><%= i.torneig_nom %></a><br><span class="meta"><%= i.starts_at %> · <%= i.club_nom %></span></td>
        <td><%= MODALITATS[i.modality] %><%= i.level ? ' · ' + i.level : '' %></td>
        <td><%= i.parella_nom %></td>
        <td>
          <% if (i.status === 'registered') { %>✅ Inscrits<%= i.paid ? '' : ' <span class="meta">(pagament pendent al club)</span>' %>
          <% } else { %>⏳ Llista d'espera<% } %>
        </td>
        <td><a href="/torneig/<%= i.tournament_id %>">Gestiona</a></td>
      </tr>
    <% } %>
  </table>
<% } %>
<% if (!inscripcions.length && !invitacionsRebudes.length && !invitacionsEnviades.length) { %>
  <p class="meta">Encara no tens inscripcions. Explora els <a href="/tornejos">tornejos</a>.</p>
<% } %>
<% if (anuncis.length) { %>
  <h3>Els meus anuncis de «busco parella»</h3>
  <ul>
  <% for (const a of anuncis) { %>
    <li><a href="/torneig/<%= a.tournament_id %>"><%= a.torneig_nom %></a>:
      <%= MODALITATS[a.modality] %><%= a.level ? ' · ' + a.level : '' %>
      <form class="enlinia" action="/torneig/<%= a.tournament_id %>/busco-parella/treu" method="post"><button class="boto secundari menut">Treu</button></form>
    </li>
  <% } %>
  </ul>
<% } %>

<h2 class="seccio">Tornejos que m'interessen</h2>
<% if (!interessos.length) { %><p>Encara no n'has desat cap. Explora els <a href="/tornejos">tornejos</a>.</p><% } %>
<div class="graella">
  <% for (const t of interessos) { %>
    <article class="targeta">
      <div class="cos">
        <h3><a href="/torneig/<%= t.id %>"><%= t.name %></a></h3>
        <div class="meta">📅 <%= t.starts_at %> · 📍 <%= t.club_nom %></div>
      </div>
    </article>
  <% } %>
</div>

<h2 class="seccio">Clubs que segueixo</h2>
<% if (!clubs.length) { %><p>Encara no segueixes cap club.</p><% } %>
<ul><% for (const c of clubs) { %><li><a href="/club/<%= c.id %>"><%= c.name %></a> (<%= c.town %>)</li><% } %></ul>
