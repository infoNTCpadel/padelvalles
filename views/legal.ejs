<script>
(function () {
  var CLAU = 'pv-consentiment';
  var estat = document.getElementById('cookies-estat-pagina');
  function mostra() {
    try {
      var v = localStorage.getItem(CLAU);
      estat.textContent = v === '1' ? 'Estat actual: acceptades.' : v === '0' ? 'Estat actual: rebutjades.' : 'Encara no heu triat.';
    } catch (e) { estat.textContent = ''; }
  }
  function desa(v) {
    try { localStorage.setItem(CLAU, v); } catch (e) {}
    mostra();
    if (v === '1') location.reload();
  }
  document.getElementById('cookies-si-pagina').addEventListener('click', function () { desa('1'); });
  document.getElementById('cookies-no-pagina').addEventListener('click', function () { desa('0'); });
  mostra();
})();
</script>

