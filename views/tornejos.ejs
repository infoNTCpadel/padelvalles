<div class="banda-pagina">
  <div class="contenidor">
    <h1>Tornejos</h1>
    <p>Tots els tornejos de pàdel del Vallès Occidental i Oriental, amb inscripció en línia.</p>
  </div>
</div>

<form class="filtres" action="/tornejos" method="get" role="search">
  <div class="camp"><label>Cerca</label><input type="search" name="q" placeholder="Torneig, club, municipi..." value="<%= filtres.q %>"></div>
  <div class="camp"><label>Comarca</label>
    <select name="comarca">
      <option value="">Totes</option>
      <% for (const [k, v] of Object.entries(COMARQUES)) { %>
        <option value="<%= k %>" <%= filtres.comarca === k ? 'selected' : '' %>><%= v %></option>
      <% } %>
    </select>
  </div>
  <div class="camp"><label>Club</label>
    <select name="club">
      <option value="">Tots</option>
      <% for (const c of clubs) { %>
        <option value="<%= c.id %>" <%= String(filtres.club) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
      <% } %>
    </select>
  </div>
  <div class="camp"><label>Modalitat</label>
    <select name="modalitat">
      <option value="">Totes</option>
      <% for (const [k, v] of Object.entries(MODALITATS)) { %>
        <option value="<%= k %>" <%= filtres.modalitat === k ? 'selected' : '' %>><%= v %></option>
      <% } %>
    </select>
  </div>
  <div class="camp"><label>Mes</label><input type="month" name="mes" value="<%= filtres.mes %>"></div>
  <div class="camp"><label>&nbsp;</label><button class="boto" type="submit">Filtra</button></div>
</form>

<% const MESOS = ['GEN','FEB','MAR','ABR','MAI','JUN','JUL','AGO','SET','OCT','NOV','DES']; %>
<% if (!tornejos.length) { %>
  <p>No hi ha tornejos amb aquests filtres.</p>
<% } %>
<div class="graella">
  <% for (const t of tornejos) { %>
    <% const d = String(t.starts_at || '').slice(8, 10); const m = MESOS[Number(String(t.starts_at || '').slice(5, 7)) - 1] || ''; %>
    <article class="targeta targeta-torneig">
      <a class="targeta-cap" href="/torneig/<%= t.id %>"><img src="/logo.webp" alt="PadelVallès"><span>PADELVALLÈS</span></a>
      <% if (d) { %><div class="targeta-data" aria-hidden="true"><span class="dia"><%= d %></span><span class="mes"><%= m %></span></div><% } %>
      <div class="cos">
        <h3><a href="/torneig/<%= t.id %>"><%= t.name %></a></h3>
        <% if (typeof estatTorneig !== 'undefined') { const e = estatTorneig(t); %><div><span class="estat <%= e.clau %>"><%= e.etiqueta %></span></div><% } %>
        <div class="meta">📍 <a href="/club/<%= t.club_id %>"><%= t.club_nom %></a><%- t.club_claimed ? ' <span class="verificat" title="Club verificat: gestionat pel propi club">✅</span>' : '' %> · <%= t.club_poble %></div>
        <a class="targeta-accio" href="/torneig/<%= t.id %>">Més informació →</a>
      </div>
    </article>
  <% } %>
</div>
