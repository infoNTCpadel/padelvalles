<h1>Panell del club</h1>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
<% if (typeof serveisPerClub !== 'undefined') { %>
<div class="dades" style="margin-bottom:1rem">
  <strong>Els teus serveis</strong>
  <% let __teAlgun = false; %>
  <% for (const c of clubs) { const __r = serveisPerClub[c.id]; if (!__r) continue;
     const __ins = __r.inscripcions.ok, __tor = __r.torneig.ok; if (__ins || __tor) __teAlgun = true; %>
    <div class="meta" style="margin-top:.3rem"><strong><%= c.name %></strong>:
      📝 Inscripcions (<%= __r.inscripcions.detall %>) ·
      🏆 Torneig (<%= __r.torneig.detall %>)
    </div>
  <% } %>
  <% if (!__teAlgun) { %><div class="meta">Tens el <strong>🪧 Dashboard</strong> gratuït. <a href="/serveis">Descobreix els serveis de pagament</a>.</div><% } %>
  <div class="meta" style="margin-top:.3rem"><a href="/club/serveis/sollicita">Sol·licita més serveis</a></div>
</div>
<% } %>
<% if (typeof esMonitor !== 'undefined' && esMonitor) { %>
<p class="avis">Has entrat com a <strong>monitor</strong>: pots veure els inscrits i fer altes i baixes dels tornejos dels clubs que t'han autoritzat.</p>
<% } %>
<% if (typeof validat !== 'undefined' && validat) { %><div class="exit">Torneig validat: ara passa a revisió de l'administrador.</div><% } %>
<% if (typeof rebutjat !== 'undefined' && rebutjat) { %><div class="exit">Torneig rebutjat: l'organitzador n'ha estat avisat.</div><% } %>
<% if (typeof pendentsOrg !== 'undefined' && pendentsOrg && pendentsOrg.length && (typeof esMonitor === 'undefined' || !esMonitor)) { %>
<h2 class="seccio">Tornejos d'organitzadors pendents de validar (<%= pendentsOrg.length %>)</h2>
<p class="meta">Aquests organitzadors volen jugar un torneig a les teves instal·lacions. Valida'ls només si hi estàs d'acord: fins que no els validis no es publicaran.</p>
<% for (const t of pendentsOrg) { %>
  <div class="dades" style="margin-bottom:.8rem">
    <strong><%= t.name %></strong> · organitza <strong><%= t.org_nom %></strong> · <%= t.starts_at %> – <%= t.ends_at %>
    <% if (t.price_text) { %><div class="meta">🎟️ <%= t.price_text %></div><% } %>
    <% if (t.description) { %><div class="meta"><%= t.description %></div><% } %>
    <div class="fila" style="margin-top:.5rem">
      <form class="enlinia" action="/club/torneig/<%= t.id %>/valida" method="post"><button class="boto menut">Valida</button></form>
      <form class="enlinia" action="/club/torneig/<%= t.id %>/rebutja" method="post">
        <input name="motiu" placeholder="Motiu del rebuig (el veurà l'organitzador)" style="width:18rem" required> <button class="boto perill menut">Rebutja</button>
      </form>
    </div>
  </div>
<% } %>
<% } %>
<div class="fila">
  <% if (typeof esMonitor === 'undefined' || !esMonitor) { %><a class="boto" href="/club/torneig/nou">+ Nou torneig</a><% } %>
  <% for (const c of clubs) { %><% if (typeof esMonitor === 'undefined' || !esMonitor) { %><a class="boto secundari menut" href="/club/perfil/<%= c.id %>">Fitxa: <%= c.name %></a><% } %><% } %>
  <% if (typeof esMonitor === 'undefined' || !esMonitor) { %><% for (const c of clubs) { %><a class="boto secundari menut" href="/club/<%= c.id %>/monitors">Monitors: <%= c.name %></a><% } %><% } %>
</div>

<h2 class="seccio">Els meus tornejos</h2>
<% if (!tornejos.length) { %><p>Encara no has creat cap torneig.</p><% } %>
<table class="llista">
  <tr><th>Torneig</th><th>Club</th><th>Dates</th><th>Servei</th><th>Estat</th><th></th></tr>
  <% for (const t of tornejos) { const sv = (typeof SERVEIS !== 'undefined' && SERVEIS[t.servei]) || { icona: '🪧', nom: 'Dashboard' }; %>
    <tr>
      <td><%= t.name %></td>
      <td><%= t.club_nom %></td>
      <td><%= t.starts_at %></td>
      <td><span class="meta"><%= sv.icona %> <%= sv.nom %></span></td>
      <td><span class="insignia <%= t.status === 'published' ? 'publicat' : t.status === 'pending' || t.status === 'pending_club' ? 'pendent' : t.status === 'rejected' ? 'rebutjat' : 'esborrany' %>"><%= t.status === 'pending_club' ? 'pendent del club' : t.status %></span>
        <% if (t.status === 'rejected' && t.reject_reason) { %><br><small><%= t.reject_reason %></small><% } %>
      </td>
      <td><% if (typeof esMonitor === 'undefined' || !esMonitor) { %><a href="/club/torneig/<%= t.id %>/edita">Edita</a> · <% } %><a href="/torneig/<%= t.id %>/cartell.svg" target="_blank" rel="noopener">Cartell</a><% if (t.status === 'published') { %> · <a href="/torneig/<%= t.id %>">Veure</a><% } %><% if ((t.registration_mode || 'externa') === 'padelvalles') { %> · <a href="/club/torneig/<%= t.id %>/inscrits"><strong>Inscrits</strong></a><% } %>
        <% if (typeof esMonitor === 'undefined' || !esMonitor) { %>
        <form class="enlinia" action="/club/torneig/<%= t.id %>/duplica" method="post" onsubmit="return confirm('Vols duplicar aquest torneig? Es copiaran les dades i les categories, sense dates ni inscrits.')"><button class="boto secundari menut" type="submit">Duplica</button></form><% } %></td>
    </tr>
  <% } %>
</table>
<p class="meta">Els tornejos nous queden <strong>pendents de revisió</strong>: els publiquem quan l'administrador els aprova.</p>
