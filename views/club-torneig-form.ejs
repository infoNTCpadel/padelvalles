<h1><%= t && t.id ? 'Edita el torneig' : 'Nou torneig' %></h1>
<% if (error) { %><div class="error"><%= error %></div><% } %>
<p class="meta">Omple les dades i nosaltres generem el cartell oficial amb la imatge de PadelVallès i el logo del teu club. El torneig es publicarà quan l'aprovem.</p>
<form class="formulari" action="<%= t && t.id ? '/club/torneig/' + t.id + '/edita' : '/club/torneig/nou' %>" method="post">
  <div class="camp"><label>Club organitzador</label>
    <select name="club_id" required>
      <% for (const c of clubs) { %><option value="<%= c.id %>" <%= t && String(t.club_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% } %>
    </select>
  </div>
  <div class="camp"><label>Nom del torneig</label><input name="nom" required maxlength="140" value="<%= t ? (t.name || t.nom || '') : '' %>" placeholder="P. ex.: Open de Tardor"></div>
  <div class="fila">
    <div class="camp"><label>Data d'inici</label><input type="date" name="inici" required value="<%= t ? (t.starts_at || t.inici || '') : '' %>"></div>
    <div class="camp"><label>Data de fi</label><input type="date" name="fi" value="<%= t ? (t.ends_at || t.fi || '') : '' %>"></div>
  </div>
  <div class="camp"><label>Categories</label>
    <% if (teInscrits > 0) { %>
      <p class="ajuda">Aquest torneig ja té <%= teInscrits %> inscripcions: no es poden canviar les categories, però sí les places.</p>
      <% for (const cat of (t.categories || [])) { %>
        <div class="fila">
          <span><strong><%= MODALITATS[cat.modality] || cat.modality %></strong><%= cat.level ? ' · ' + cat.level : '' %></span>
          <label>Places <input name="places_<%= cat.id %>" type="number" min="1" max="500" style="width:5rem" placeholder="∞" value="<%= cat.max_pairs || '' %>"></label>
        </div>
      <% } %>
    <% } else { %>
    <div class="fila">
      <% const mods = Object.keys(MODALITATS); %>
      <% mods.forEach((k, i) => { %>
        <% const cat = t && t.categories ? t.categories.find(c => c.modality === k) : null; %>
        <label><input type="checkbox" name="modalitat" value="<%= k %>" <%= cat ? 'checked' : (!t ? 'checked' : '') %>> <%= MODALITATS[k] %></label>
        <input name="nivell" placeholder="Nivell (opcional)" value="<%= cat ? cat.level : '' %>" style="width:8rem">
        <input name="places" type="number" min="1" max="500" placeholder="Places" title="Places per categoria (buit = sense límit)" value="<%= cat && cat.max_pairs ? cat.max_pairs : '' %>" style="width:5.5rem">
      <% }); %>
    </div>
    <% } %>
  </div>
  <div class="camp"><label>Preu</label><input name="preu" maxlength="80" value="<%= t ? (t.price_text || t.preu || '') : '' %>" placeholder="P. ex.: 20 € per persona"></div>
  <div class="camp"><label>On es fan les inscripcions?</label>
    <select name="mode_inscripcio" id="modeInscripcio">
      <option value="externa" <%= t && (t.registration_mode || t.mode_inscripcio || 'externa') === 'externa' ? 'selected' : '' %>>Al web del club (enllaç extern)</option>
      <option value="padelvalles" <%= t && (t.registration_mode || t.mode_inscripcio) === 'padelvalles' ? 'selected' : '' %>>A PadelVallès</option>
    </select>
    <div id="avisQuota" class="avis" style="display:none;margin-top:.5rem"></div>
  </div>
  <div id="campsInscripcio" style="display:none">
    <div class="fila">
      <div class="camp"><label>Tancament d'inscripcions</label>
        <input type="date" name="data_limit" value="<%= t ? (t.registration_deadline || t.data_limit || '') : '' %>">
        <span class="ajuda">Buit = fins al dia abans del torneig.</span>
      </div>
      <div class="camp"><label>Els jugadors es poden donar de baixa fins a</label>
        <div><input type="number" name="hores_baixa" min="0" max="720" style="width:5rem" value="<%= t ? (t.unregister_hours ?? t.hores_baixa ?? 48) : 48 %>"> hores abans de l'inici</div>
        <span class="ajuda">Passat aquest termini hauran de contactar amb el club.</span>
      </div>
    </div>
  </div>
<script>
const QUOTES = <%- JSON.stringify(quotes || {}) %>;
const selClub = document.querySelector('select[name="club_id"]');
const selMode = document.getElementById('modeInscripcio');
const avis = document.getElementById('avisQuota');
const camps = document.getElementById('campsInscripcio');
function actualitzaQuota() {
  const esPV = selMode.value === 'padelvalles';
  camps.style.display = esPV ? '' : 'none';
  if (!esPV) { avis.style.display = 'none'; return; }
  const n = QUOTES[selClub.value] || 0;
  avis.style.display = '';
  avis.innerHTML = n === 0
    ? '<strong>El primer torneig del club amb inscripció a PadelVallès és gratuït.</strong>'
    : '<strong>Recorda:</strong> a partir del segon torneig amb inscripció a PadelVallès s\u2019aplicarà una petita quota (fixa o per inscrit). T\u2019avisarem abans que entri en vigor.';
}
selClub.addEventListener('change', actualitzaQuota);
selMode.addEventListener('change', actualitzaQuota);
actualitzaQuota();
</script>
  <div class="camp"><label>Com s'hi inscriu la gent?</label>
    <input name="via" maxlength="300" value="<%= t ? (t.registration_info || t.via || '') : '' %>" placeholder="P. ex.: WhatsApp al 600 123 456">
  </div>
  <div class="camp"><label>Enllaç d'inscripció (opcional)</label><input name="url" type="url" maxlength="300" value="<%= t ? (t.registration_url || t.url || '') : '' %>" placeholder="https://..."></div>
  <div class="camp"><label>Descripció</label><textarea name="descripcio" rows="5" maxlength="2000"><%= t ? (t.description || t.descripcio || '') : '' %></textarea></div>
  <button class="boto" type="submit">Envia a revisió</button>
</form>
